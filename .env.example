# inside this file or compile them into the Flutter application binaries.
#
# Pass these variables at build or launch time using --dart-define or --dart-define-from-file:
# flutter run -d chrome --dart-define-from-file=.env
# flutter build appbundle --dart-define-from-file=.env
# ==============================================================================

